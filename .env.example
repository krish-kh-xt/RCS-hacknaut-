# Overview of every environment variable in RCS. Real values go in each folder's own .env (never committed).
# Copy the matching block into backend/.env, frontend/.env or dashboard/.env.

# ---- backend/.env ----
PORT=4000
DATABASE_URL=
SMS_MODE=mock
SMS_API_KEY=
SILENCE_LIMIT_MIN=60
ESCALATE_AFTER_MIN=10
NEARBY_RADIUS_M=30000
DEMO_MODE=false
ALLOWED_ORIGINS=

# ---- frontend/.env ----
VITE_API_URL=http://localhost:4000
VITE_SYNC_INTERVAL_MS=300000

# ---- dashboard/.env ----
# VITE_API_URL=http://localhost:4000
